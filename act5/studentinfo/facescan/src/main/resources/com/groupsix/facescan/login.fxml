<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.LineTo?>
<?import javafx.scene.shape.MoveTo?>
<?import javafx.scene.shape.Path?>
<?import javafx.scene.shape.QuadCurveTo?>

<StackPane fx:id="rootPane" prefHeight="650.0" prefWidth="1050.0" style="-fx-background-color: #F2F2F7;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.groupsix.facescan.LoginController">

    <!-- Premium iOS Content Card Container -->
    <VBox alignment="CENTER" maxWidth="400" maxHeight="490" spacing="28" style="-fx-background-color: #FFFFFF; -fx-background-radius: 24; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 25, 0.0, 0, 8);">
        <padding>
            <Insets top="35" right="35" bottom="35" left="35" />
        </padding>

        <VBox alignment="CENTER" spacing="6">
            <Label text="Face ID" style="-fx-font-family: 'SF Pro Display', -apple-system, sans-serif; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #000000;" />
            <Label text="Group 6 Attendance System" style="-fx-font-family: 'SF Pro Text', sans-serif; -fx-font-size: 14px; -fx-text-fill: #8E8E93;" />
        </VBox>

        <!-- Face Target Bracket Container -->
        <VBox alignment="CENTER">
            <StackPane fx:id="scannerContainer" style="-fx-background-color: #F2F2F7; -fx-background-radius: 20; -fx-pref-width: 180; -fx-pref-height: 180; -fx-max-width: 180;">
                <Group>
                    <Path fill="transparent" stroke="#007AFF" strokeLineCap="ROUND" strokeLineJoin="ROUND" strokeWidth="4">
                        <elements>
                            <MoveTo x="-40.0" y="-20.0" />
                            <QuadCurveTo controlX="-40.0" controlY="-40.0" x="-20.0" y="-40.0" />
                        </elements>
                    </Path>
                    <Path fill="transparent" stroke="#007AFF" strokeLineCap="ROUND" strokeLineJoin="ROUND" strokeWidth="4">
                        <elements>
                            <MoveTo x="20.0" y="-40.0" />
                            <QuadCurveTo controlX="40.0" controlY="-40.0" x="40.0" y="-20.0" />
                        </elements>
                    </Path>
                    <Path fill="transparent" stroke="#007AFF" strokeLineCap="ROUND" strokeLineJoin="ROUND" strokeWidth="4">
                        <elements>
                            <MoveTo x="-40.0" y="20.0" />
                            <QuadCurveTo controlX="-40.0" controlY="40.0" x="-20.0" y="40.0" />
                        </elements>
                    </Path>
                    <Path fill="transparent" stroke="#007AFF" strokeLineCap="ROUND" strokeLineJoin="ROUND" strokeWidth="4">
                        <elements>
                            <MoveTo x="20.0" y="40.0" />
                            <QuadCurveTo controlX="40.0" controlY="40.0" x="40.0" y="20.0" />
                        </elements>
                    </Path>

                    <Circle centerX="-12" centerY="-8" fill="#007AFF" radius="4.5" />
                    <Circle centerX="12" centerY="-8" fill="#007AFF" radius="4.5" />
                    
                    <Path fx:id="faceMouthPath" fill="transparent" stroke="#007AFF" strokeLineCap="ROUND" strokeWidth="4">
                        <elements>
                            <MoveTo x="-18.0" y="16.0" />
                            <QuadCurveTo controlX="0.0" controlY="16.0" x="18.0" y="16.0" />
                        </elements>
                    </Path>
                </Group>
                
                <Line fx:id="scanLine" endX="70" startX="-70" stroke="#007AFF" strokeWidth="2" visible="false" />
            </StackPane>
        </VBox>

        <VBox alignment="CENTER" spacing="16" VBox.vgrow="ALWAYS">
            <Label fx:id="statusLabel" text="Ready to Scan" style="-fx-font-family: 'SF Pro Text', sans-serif; -fx-font-size: 15px; -fx-text-fill: #1C1C1E; -fx-font-weight: 500;" />
            <Button fx:id="scanButton" onAction="#handleFaceScan" text="Authenticate" style="-fx-background-color: #007AFF; -fx-text-fill: #FFFFFF; -fx-font-family: 'SF Pro Text', sans-serif; -fx-font-size: 16px; -fx-font-weight: 600; -fx-background-radius: 12; -fx-pref-height: 46; -fx-max-width: Infinity; -fx-cursor: hand;" />
        </VBox>
    </VBox>
</StackPane>