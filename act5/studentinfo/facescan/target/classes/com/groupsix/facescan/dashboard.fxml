<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.geometry.Insets?>

<HBox style="-fx-background-color: #F2F2F7; -fx-pref-width: 1050; -fx-pref-height: 650;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.groupsix.facescan.DashboardController">
    
    <!-- Sidebar Navigation Frame -->
    <VBox fx:id="sidebarContainer" style="-fx-background-color: #E5E5EA; -fx-pref-width: 220; -fx-min-width: 220;" spacing="6">
        <padding>
            <Insets top="30" right="12" bottom="24" left="12"/>
        </padding>
        
        <Label text="Logs Panel" style="-fx-font-family: 'SF Pro Display', sans-serif; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #000000;">
            <padding>
                <Insets bottom="16" left="8"/>
            </padding>
        </Label>
        
        <Button text="Attendance Logs" style="-fx-background-color: #FFFFFF; -fx-text-fill: #007AFF; -fx-alignment: center-left; -fx-font-family: 'SF Pro Text', sans-serif; -fx-font-weight: bold; -fx-background-radius: 10; -fx-pref-height: 38; -fx-max-width: Infinity; -fx-padding: 0 12 0 12;"/>
        <Button text="System Reports" style="-fx-background-color: transparent; -fx-text-fill: #3A3A3C; -fx-alignment: center-left; -fx-font-family: 'SF Pro Text', sans-serif; -fx-background-radius: 10; -fx-pref-height: 38; -fx-max-width: Infinity; -fx-padding: 0 12 0 12;"/>
        
        <Region VBox.vgrow="ALWAYS" />
        <Button text="Sign Out" onAction="#handleLogout" style="-fx-background-color: #FF3B30; -fx-text-fill: #FFFFFF; -fx-alignment: center; -fx-font-family: 'SF Pro Text', sans-serif; -fx-font-weight: bold; -fx-background-radius: 10; -fx-pref-height: 38; -fx-max-width: Infinity; -fx-cursor: hand Pap;"/>
    </VBox>

    <!-- Core Working Workspace Content Layout -->
    <VBox spacing="16" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        
        <!-- Header Ribbon Section -->
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #FFFFFF; -fx-padding: 12 16 12 16; -fx-background-radius: 14; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0.0, 0, 2);">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Attendance Tracking Sheet" style="-fx-font-family: 'SF Pro Display', sans-serif; -fx-font-size: 18px; -fx-text-fill: #000000; -fx-font-weight: bold;"/>
            </VBox>
            
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Button fx:id="btnMinimizeWorkspace" text="Collapse Layout" onAction="#toggleMinimizeWorkspace" style="-fx-background-color: #E5E5EA; -fx-text-fill: #3A3A3C; -fx-background-radius: 8; -fx-font-family: 'SF Pro Text', sans-serif; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 6 12 6 12;"/>
                <Button fx:id="btnMaximizeWorkspace" text="Maximize View" onAction="#toggleMaximizeWorkspace" style="-fx-background-color: #007AFF; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-family: 'SF Pro Text', sans-serif; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 6 12 6 12;"/>
            </HBox>
        </HBox>

        <VBox fx:id="collapsibleContentArea" spacing="16" VBox.vgrow="ALWAYS">
            
            <!-- Quick Add Registry Options Form Card Bar -->
            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #FFFFFF; -fx-padding: 12; -fx-background-radius: 14; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0.0, 0, 2);">
                <TextField fx:id="nameInputField" promptText="Enter Employee Name" style="-fx-background-color: #F2F2F7; -fx-background-radius: 8; -fx-pref-height: 36; -fx-padding: 0 12 0 12; -fx-font-family: 'SF Pro Text', sans-serif;" HBox.hgrow="ALWAYS"/>
                <Button text="Add Record" onAction="#handleAddRecord" style="-fx-background-color: #34C759; -fx-text-fill: white; -fx-background-radius: 8; -fx-pref-height: 36; -fx-font-family: 'SF Pro Text', sans-serif; -fx-font-weight: bold; -fx-padding: 0 16 0 16; -fx-cursor: hand;"/>
                <Button text="Delete" onAction="#handleDeleteRecord" style="-fx-background-color: transparent; -fx-text-fill: #FF3B30; -fx-border-color: #FF3B30; -fx-border-radius: 8; -fx-pref-height: 34; -fx-font-family: 'SF Pro Text', sans-serif; -fx-cursor: hand;"/>
            </HBox>

            <!-- Table Logs View Sheet Component -->
            <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-background-radius: 14; -fx-border-color: transparent; -fx-padding: 6; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 15, 0.0, 0, 4);">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="90">
                        <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colName" text="Employee" prefWidth="280">
                        <cellValueFactory><PropertyValueFactory property="employeeName"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colTimestamp" text="Timestamp" prefWidth="220">
                        <cellValueFactory><PropertyValueFactory property="timestamp"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="160">
                        <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</HBox>